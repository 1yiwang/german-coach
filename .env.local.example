# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .gitignore line ".env*").

# DeepSeek API (OpenAI-compatible)
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Supabase (project + keys from Dashboard → Settings → API)
# - NEXT_PUBLIC_SUPABASE_URL    -> "Project URL"  (e.g. https://xxxxx.supabase.co)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY  -> "anon / public" key   (safe in the browser)
# - SUPABASE_SERVICE_ROLE_KEY      -> "service_role" key    (server-only, bypasses RLS — never expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram reminder bot (created via @BotFather)
TELEGRAM_BOT_TOKEN=
APP_BASE_URL=http://localhost:3000
